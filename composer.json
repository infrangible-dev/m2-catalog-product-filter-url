{
    "name": "infrangible/m2-catalog-product-filter-url",
    "description": "Carries the selected layered navigation filters into product links, so a shopper who filtered by color or size lands on the product page with that variant preselected.",
    "type": "magento2-module",
    "version": "1.0.3",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Layered navigation",
        "Product options",
        "Catalog",
        "Hyvä",
        "preselect variant from layered navigation filter",
        "carry filters to the product page",
        "filtered color preselected"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-product-filter-url",
    "authors": [
        {
            "name": "Philipp Adler",
            "email": "p.adler@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        },
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-foundation": "~2.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductFilterUrl\\": "src"
        }
    }
}
